rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper to ensure the caller is a signed‑in user
    function isSignedIn() {
      return request.auth != null;
    }

    // ---------------------------------------------------------------------
    // Groups collection
    // ---------------------------------------------------------------------
    match /groups/{groupId} {
      // 1. Read – only members of the group may read it (including list queries)
      allow read: if isSignedIn() && request.auth.uid in resource.data.memberIds;

      // 2. Create – the caller must be authenticated, be the creator, be the only
      //    initial member, and provide a non‑empty name. The member list must contain
      //    exactly the creator's UID.
      allow create: if isSignedIn()
                     && request.resource.data.creatorId == request.auth.uid
                     && request.resource.data.memberIds is list
                     && request.resource.data.memberIds == [request.auth.uid]
                     && request.resource.data.name is string
                     && request.resource.data.name.size() > 0;

      // 3. Update – allow a signed-in user to join the group using a valid invitation token:
      //    - User must be signed in.
      //    - Only memberIds and inviteToken can be updated.
      //    - Existing members, creatorId, and name are preserved.
      //    - The caller can only add their own UID to memberIds.
      //    - The token must exist in the invitations collection and point to this group.
      allow update: if isSignedIn()
                     && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'inviteToken'])
                     && request.resource.data.creatorId == resource.data.creatorId
                     && request.resource.data.name == resource.data.name
                     && request.resource.data.memberIds is list
                     && resource.data.memberIds is list
                     && request.resource.data.memberIds.hasAll(resource.data.memberIds)
                     && request.auth.uid in request.resource.data.memberIds
                     && !(request.auth.uid in resource.data.memberIds)
                     && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
                     && 'inviteToken' in request.resource.data
                     && request.resource.data.inviteToken is string
                     && exists(/databases/$(database)/documents/invitations/$(request.resource.data.inviteToken))
                     && get(/databases/$(database)/documents/invitations/$(request.resource.data.inviteToken)).data.groupId == groupId;

      // 4. Delete – not allowed yet (features not implemented)
      allow delete: if false;

      // ---------------------------------------------------------------------
      // Debts subcollection
      // ---------------------------------------------------------------------
      match /debts/{debtId} {
        // Only signed-in group members can read group debts
        allow read: if isSignedIn()
                    && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;

        // Only signed-in group members can add a debt
        // Debtor and creditor must both belong to the group and be different members
        // Amount must be positive, status must be 'open', creator must match auth.uid
        allow create: if isSignedIn()
                      && request.resource.data.groupId == groupId
                      && request.resource.data.creatorId == request.auth.uid
                      && request.resource.data.status == 'open'
                      && request.resource.data.amount is number
                      && request.resource.data.amount > 0
                      && request.resource.data.debtorId is string
                      && request.resource.data.creditorId is string
                      && request.resource.data.debtorId != request.resource.data.creditorId
                      && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds
                      && request.resource.data.debtorId in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds
                      && request.resource.data.creditorId in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;

        // Prevent users from changing or deleting debt records for now
        allow update, delete: if false;
      }
    }

    // ---------------------------------------------------------------------
    // Invitations collection – one‑time tokens to join a group
    // ---------------------------------------------------------------------
    match /invitations/{invId} {
      // Only signed‑in users can create an invitation, and only for groups they
      // are already a member of.
      allow create: if isSignedIn()
                     && request.resource.data.creatorId == request.auth.uid
                     && request.resource.data.groupId is string
                     && exists(/databases/$(database)/documents/groups/$(request.resource.data.groupId))
                     && request.auth.uid in get(/databases/$(database)/documents/groups/$(request.resource.data.groupId)).data.memberIds;

      // Allow get (single document lookup by token), but disallow list (browsing invitations)
      allow get: if isSignedIn();
      allow list: if false;

      // Only the invitation creator or a verified member of the group can delete it.
      // When an invited user joins, their UID is added to the group's memberIds first,
      // which permits them to delete the consumed token and prevents unrelated users from disrupting it.
      allow delete: if isSignedIn()
                     && (
                       request.auth.uid == resource.data.creatorId
                       || (
                         exists(/databases/$(database)/documents/groups/$(resource.data.groupId))
                         && request.auth.uid in get(/databases/$(database)/documents/groups/$(resource.data.groupId)).data.memberIds
                       )
                     );

      // No updates – an invitation is immutable.
      allow update: if false;
    }
  }
}
